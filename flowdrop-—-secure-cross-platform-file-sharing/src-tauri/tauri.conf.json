{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FlowDrop",
  "version": "2.4.0",
  "identifier": "com.flowdrop.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "FlowDrop",
        "width": 1180,
        "height": 780,
        "minWidth": 720,
        "minHeight": 540,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": "default-src 'self' blob: data:; img-src 'self' asset: https: blob: data:; media-src 'self' blob: asset:; connect-src 'self' ws: wss: https:;"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "apk"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.digicert.com",
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico"
      }
    },
    "android": {
      "minSdkVersion": 26,
      "targetSdkVersion": 34
    }
  }
}
